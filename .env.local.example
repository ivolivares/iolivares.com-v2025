# Notion Integration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...

# Database ID (used as data_source_id in Notion API v5)
# Can be in any of these formats:
# - Full URL: https://www.notion.so/workspace/a8aec43384f447ed84390e8e42c2e089?v=...
# - With hyphens: a8aec433-84f4-47ed-8439-0e8e42c2e089
# - Without hyphens: a8aec43384f447ed84390e8e42c2e089
# To find it: Open your database in Notion, copy the URL, and paste it here
# Note: The code will automatically normalize any format
NOTION_DATABASE_ID=your_notion_database_id_here

# Leads from /services. Same integration token as NOTION_TOKEN.
# Database ID or URL of the leads database (not the blog database).
# Leave unset locally to write inquiries to .data/service-inquiries.jsonl.
# Do not commit a real id. On Cloudflare, set it with:
#   pnpm exec wrangler secret put NOTION_LEADS_DATABASE_ID
#   pnpm exec wrangler secret put NOTION_LEADS_DATABASE_ID --env preview
NOTION_LEADS_DATABASE_ID=

# Draft Mode Secret (can be any random string, e.g. generated with `openssl rand -hex 32`)
DRAFT_SECRET_TOKEN=your_random_secret_here

# Services lead form. Public site key (safe to expose) and secret (Worker secret, do not commit).
# Create a widget at Cloudflare → Turnstile, with domains iolivares.com, preview.iolivares.com, and localhost.
# Locally these can stay empty: the form uses Cloudflare's always-pass test keys on localhost.
#   pnpm exec wrangler secret put TURNSTILE_SECRET_KEY
#   pnpm exec wrangler secret put TURNSTILE_SECRET_KEY --env preview
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the email code cookie. If unset, the Worker falls back to DRAFT_SECRET_TOKEN.
# SERVICES_OTP_SECRET=

# Sends the 6-digit code from hi@iolivares.com through the SERVICES_EMAIL binding
# (Cloudflare Email Service). Without that binding, local dev shows the code on
# screen and production refuses to reveal prices.

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_TOKEN=ph_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # Or https://eu.i.posthog.com
